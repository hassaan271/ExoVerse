{
  "name": "exoverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/build-catalog.mjs && node scripts/build-observatories.mjs && node --no-warnings scripts/build-habitability.mjs && node scripts/validate-catalog.mjs",
    "test": "node --no-warnings --test scripts/habitability.test.mjs scripts/chat.test.mjs scripts/agent.test.mjs",
    "ai:check": "node --no-warnings --env-file-if-exists=.env.local scripts/ai-check.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "next": "^16.4.3",
    "openai": "^7.46.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
